---
import LabLayout from '../../layouts/LabLayout.astro';
import { projects, buildRings, buildKnots, CURRENT_YEAR, FIRST_YEAR } from '../../lab/data';
import { svgCut } from '../../lab/svgCut';

const rings = buildRings();
const knots = buildKnots(rings);
const svg = svgCut(rings, knots);

const years: number[] = [];
for (let y = CURRENT_YEAR; y >= FIRST_YEAR; y--) years.push(y);
const byYear = new Map<number, typeof projects>();
for (const y of years) byYear.set(y, projects.filter((p) => Math.floor(p.start) === y).sort((a, b) => b.start - a.start));

const payload = {
  rings,
  knots,
  projects: projects.map((p) => ({ slug: p.slug, title: p.title, href: p.href, dateLabel: p.dateLabel, side: p.side })),
};
---
<LabLayout title="Cut — Art Androsov (lab)">
  <header class="top">
    <a class="brand" href="/lab/srez" aria-label="Art Androsov, home">
      <img src="/assets/icons/ArtLogo.svg" alt="" width="28" height="28" />
      <span>Art Androsov</span>
    </a>
    <nav aria-label="Main">
      <a href="/lab/srez" aria-current="page">Work</a>
      <a href="/about">About</a>
    </nav>
  </header>

  <main class="cut">
    <section class="intro">
      <h1>I design products and build them myself with&nbsp;AI.</h1>
      <p class="legend">
        A cut of a pine trunk. One ring is one year. Knots are projects: the longer the knot, the longer it ran.
        Client work on the right, my own on the left.
      </p>
    </section>

    <div class="stage" id="stage">
      <div class="disc-svg" id="disc-svg" set:html={svg} />
      <canvas id="disc" aria-hidden="true"></canvas>
      <div class="labels" id="labels" aria-hidden="true"></div>
      <div class="tip" id="tip" role="status" aria-live="polite"></div>
      <div class="sides" role="group" aria-label="Show on the cut">
        <button type="button" data-side="own"><span aria-hidden="true" class="half half-l"></span>Self-initiated</button>
        <button type="button" data-side="client">Client work<span aria-hidden="true" class="half half-r"></span></button>
      </div>
      <svg class="leader" id="leader" aria-hidden="true"><line x1="0" y1="0" x2="0" y2="0" /></svg>
    </div>

    <div class="index">

      {years.map((y) => {
        const list = byYear.get(y)!;
        const ring = rings.find((r) => r.year === y)!;
        return (
          <section class="year" data-year={y} data-ring={rings.indexOf(ring)} aria-labelledby={`y${y}`}>
            <h2 id={`y${y}`}>{y}</h2>
            {list.length === 0 ? (
              <p class="quiet">{ring.count === 1 ? 'One project running, no new starts.' : `${ring.count} projects running, no new starts.`}</p>
            ) : (
              <ul>
                {list.map((p) => (
                  <li data-knot={p.slug} data-side={p.side}>
                    <span class="glyph" aria-hidden="true"></span>
                    {p.href ? (
                      <a class="p-title" href={p.href} target={p.href.startsWith('http') ? '_blank' : undefined} rel={p.href.startsWith('http') ? 'noopener' : undefined}>{p.title}</a>
                    ) : (
                      <span class="p-title">{p.title}</span>
                    )}
                    <p class="p-meta"><span class="p-date">{p.dateLabel}</span><span>{p.tags.filter((t) => t !== 'Self-initiated').join(', ')}{p.side === 'own' ? ', self-initiated' : ''}</span></p>
                    {p.description && <p class="p-desc" set:html={p.description} />}
                  </li>
                ))}
              </ul>
            )}
          </section>
        );
      })}

      <footer class="foot">
        <p>The pith is {FIRST_YEAR}, the first year of design work. A new ring is added every January.</p>
        <p>
          <a href="mailto:art.androsov@gmail.com">art.androsov@gmail.com</a><br />
          <a href="https://t.me/androsovart" target="_blank" rel="noopener">Telegram</a>,
          <a href="https://www.linkedin.com/in/artandrosov/" target="_blank" rel="noopener">LinkedIn</a>,
          <a href="https://www.youtube.com/@wedesignerz" target="_blank" rel="noopener">YouTube</a>
        </p>
      </footer>
    </div>
  </main>

  <div class="fps" id="fps" hidden></div>

  <script type="application/json" id="cut-data" set:html={JSON.stringify(payload)} />

  <script>
    import { startCut } from '../../lab/cutScene';
    startCut();
  </script>
</LabLayout>

<style>
  .top {
    position: fixed; inset: 0 0 auto 0; z-index: 5;
    display: flex; justify-content: space-between; align-items: center;
    padding: 18px 28px;
    pointer-events: none;
  }
  .top > * { pointer-events: auto; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 520; letter-spacing: -0.01em; }
  .brand img { display: block; }
  nav { display: flex; gap: 24px; }
  nav a { text-decoration: none; color: var(--needle-2); font-weight: 420; }
  nav a[aria-current] { color: var(--needle); text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }

  .cut {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    grid-template-areas: "stage intro" "stage index";
    grid-template-rows: auto 1fr;
    min-height: 100vh;
  }
  .intro { grid-area: intro; padding: 120px 56px 0 8px; max-width: 560px; }
  .index { grid-area: index; }

  .stage {
    grid-area: stage; align-self: start;
    position: sticky; top: 0;
    height: 100vh; height: 100svh;
    overflow: hidden;
  }
  .disc-svg {
    position: absolute; left: 50%; top: 52%;
    width: min(64vh, 80%); aspect-ratio: 1;
    transform: translate(-50%, -50%) perspective(1400px) rotateX(48deg);
    transition: opacity 0.6s ease;
  }
  .disc-svg :global(svg) { width: 100%; height: 100%; display: block; filter: drop-shadow(0 30px 30px rgba(31, 43, 36, 0.18)); }
  .stage.is-3d .disc-svg { opacity: 0; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 0.5s ease; }
  .stage.is-3d canvas { opacity: 1; }
  .stage.is-hot canvas { cursor: pointer; }

  .labels { position: absolute; inset: 0; pointer-events: none; }
  .labels :global(span) {
    position: absolute; left: 0; top: 0;
    font-size: 12px; font-variant-numeric: tabular-nums; font-weight: 450;
    color: rgba(31, 43, 36, 0.62);
    white-space: nowrap;
    transition: color 0.25s ease, font-weight 0.25s ease;
  }
  .labels :global(span.is-active) { color: var(--needle); font-weight: 650; }
  .labels :global(span.side) { font-size: 13px; color: var(--needle-2); font-weight: 420; }

  /* label printed next to the knot, tied to it with a thin leader line */
  .tip {
    position: absolute; left: 0; top: 0; z-index: 3;
    pointer-events: none;
    color: var(--needle);
    font-size: 17px; font-weight: 520; line-height: 1.2; letter-spacing: -0.01em;
    opacity: 0;
    transition: opacity 0.15s ease;
    white-space: nowrap;
    text-shadow: 0 0 6px var(--fog), 0 0 2px var(--fog), 0 0 12px var(--fog);
  }
  .tip.is-on { opacity: 1; }
  .tip :global(small) { display: block; font-size: 13px; font-weight: 400; color: var(--needle-2); margin-top: 3px; }
  .leader { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; opacity: 0; transition: opacity 0.15s ease; overflow: visible; }
  .leader.is-on { opacity: 1; }
  .leader line { stroke: var(--needle); stroke-width: 1; }

  .sides {
    position: absolute; left: 28px; right: 28px; bottom: 24px;
    display: flex; justify-content: space-between; gap: 8px;
  }
  .half { display: inline-block; width: 7px; height: 14px; border: 1.5px solid currentColor; vertical-align: -2px; }
  .half-l { border-radius: 14px 0 0 14px; border-right: 0; margin-right: 8px; }
  .half-r { border-radius: 0 14px 14px 0; border-left: 0; margin-left: 8px; }
  .sides button {
    font: inherit; font-size: 14px; color: var(--needle);
    background: transparent; border: 1px solid rgba(31, 43, 36, 0.28);
    border-radius: 100px; padding: 6px 14px; cursor: pointer;
  }
  .sides button[aria-pressed="true"] { background: var(--needle); color: var(--fog); border-color: var(--needle); }

  .index { padding: 0 56px 80px 8px; max-width: 560px; }
  .intro h1 {
    font-size: clamp(30px, 3.1vw, 46px); line-height: 1.08; font-weight: 380; letter-spacing: -0.025em;
    margin: 0 0 28px; max-width: 14ch;
  }
  .legend { color: var(--needle-2); margin: 0 0 48px; max-width: 44ch; font-size: 16px; }

  .year { padding: 56px 0 8px; }
  .year h2 {
    margin: 0 0 18px; font-size: 40px; line-height: 1;
    font-weight: 260; letter-spacing: -0.03em; font-variant-numeric: tabular-nums;
    color: #5F6B63;
    transition: color 0.3s ease, font-weight 0.3s ease;
  }
  .year.is-active h2 { color: var(--needle); font-weight: 420; }
  .year ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
  .year li { position: relative; padding-left: 22px; transition: opacity 0.2s ease; }
  /* knot glyph: same shape as on the cut, fills with resin when the knot is lit */
  .glyph {
    position: absolute; left: 0; top: 9px;
    width: 6px; height: 13px; border-radius: 3px 3px 4px 4px / 3px 3px 7px 7px;
    background: #7A4E2E;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .year li.is-hot .glyph { background: var(--resin); box-shadow: 0 0 0 3px rgba(227, 161, 47, 0.3); }
  .year li.is-hot .p-title { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .p-title { font-size: 22px; font-weight: 500; letter-spacing: -0.015em; text-decoration: none; }
  a.p-title:hover { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .p-meta { margin: 4px 0 8px; color: var(--needle-2); font-size: 14px; line-height: 1.45; display: flex; flex-wrap: wrap; column-gap: 14px; }
  .p-date { color: var(--needle); }
  .p-desc { margin: 0; max-width: 46ch; font-size: 16px; }
  .quiet { color: var(--needle-2); margin: 0; font-size: 15px; }

  .foot { margin-top: 88px; min-height: 78vh; min-height: 78svh; display: flex; flex-direction: column; justify-content: flex-end; padding-bottom: 32vh; color: var(--needle-2); font-size: 15px; }
  .foot p { max-width: 40ch; }
  .foot a { color: var(--needle); }

  .fps { position: fixed; right: 12px; bottom: 12px; z-index: 9; background: var(--needle); color: var(--fog); font-size: 12px; padding: 4px 8px; border-radius: 4px; font-variant-numeric: tabular-nums; }

  @media (max-width: 820px) {
    .top { position: static; padding: 14px 16px 0; }
    nav { gap: 18px; }
    .cut { display: block; }
    .intro { padding: 20px 16px 8px; max-width: none; }
    .intro h1 { font-size: 30px; margin-bottom: 12px; }
    .legend { font-size: 15px; margin-bottom: 0; }
    .stage { height: 44svh; z-index: 2; background: var(--fog); }
    .stage::after { content: ""; position: absolute; left: 0; right: 0; bottom: -24px; height: 24px; background: linear-gradient(var(--fog), rgba(220, 225, 219, 0)); pointer-events: none; }
    .disc-svg { width: min(32svh, 72vw); top: 50%; }
    .sides { left: 12px; right: 12px; bottom: 6px; }
    .sides button { font-size: 13px; padding: 4px 11px; }
    .index { padding: 8px 16px 64px; max-width: none; }
    .year { padding-top: 40px; }
    .year h2 { font-size: 32px; }
    .p-title { font-size: 20px; }
    .foot { min-height: 0; padding-bottom: 50svh; }
  }
</style>
